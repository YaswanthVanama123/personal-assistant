#!/bin/bash
# Jeeves launcher. Keeps the repo self-contained: no install step, no pip.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"

PYTHON="${JEEVES_PYTHON:-}"
if [[ -z "$PYTHON" ]]; then
  for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then PYTHON="$candidate"; break; fi
  done
fi
if [[ -z "$PYTHON" ]]; then
  echo "jeeves: no python3 found on PATH (need 3.11+)." >&2
  exit 1
fi

# tomllib landed in 3.11; fail early with a clear message rather than a traceback.
if ! "$PYTHON" -c 'import sys, tomllib; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
  echo "jeeves: $PYTHON is too old — Python 3.11 or newer is required." >&2
  exit 1
fi

exec "$PYTHON" -m jeeves "$@"
